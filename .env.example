# Resend — used by /api/proposal route to send pre-qualification form emails
# Get the API key from https://resend.com/api-keys
RESEND_API_KEY=

# Optional — defaults to "Pan <pan@pallanca.net>"
# Must be a verified sender on Resend (verify domain pallanca.net there)
RESEND_FROM_ADDRESS=

# Optional — defaults to "pan@piirz.com"
RESEND_TO_ADDRESS=

# Anti-bot (src/lib/formGuard.ts). Optional: secret for signing form tokens;
# if empty, a key derived from RESEND_API_KEY is used.
FORM_SECRET=

# Cloudflare Turnstile. Site key defaults in code to 0x4AAAAAAFt4NXpFigjtb52l (override here, build-time).
# The server enforces it only if TURNSTILE_SECRET is set. Paste the secret ONLY into Vercel.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=
# Accepted frontend hostnames (default: pallanca.info,www.pallanca.info). Never localhost in production.
TURNSTILE_HOSTNAMES=
